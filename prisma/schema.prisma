generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Role {
  Admin
  Order_Taker
  Shop_Owner
  Chef
}

model Users {
  id              Int      @id @default(autoincrement())
  name            String   @db.Char(100)
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userRoles      UserRole[]
  otps           Otp[]
  passwordResets PasswordReset[]

   waiterConnection WaiterConnection?
   chefConnection ChefConnection?

}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      Role
  token     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model WaiterConnection {
  id             Int      @id @default(autoincrement())
  Order_Taker_ID Int      @unique
  socketId       String?  @unique
  sessionToken   String   @unique  
  isActive       Boolean  @default(true)
  fromTime       String?  
  toTime         String? 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  waiter Users @relation(fields: [Order_Taker_ID], references: [id], onDelete: Cascade)
}

model ChefConnection {
  id           Int      @id @default(autoincrement())
  Chef_ID      Int      @unique
  socketId     String?  @unique
  sessionToken String   @unique
  isActive     Boolean  @default(true)
  fromTime     String?
  toTime       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chef Users @relation(fields: [Chef_ID], references: [id], onDelete: Cascade)
}