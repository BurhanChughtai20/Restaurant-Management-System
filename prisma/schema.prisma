generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Role {
  Admin
  Order_Taker
  Shop_Owner
  Chef
}

enum OrderStatus {
  PENDING
  PICKED
  READY
  COMPLETED
}

model Users {
  id              Int      @id @default(autoincrement())
  name            String   @db.Char(100)
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userRoles      UserRole[]
  otps           Otp[]
  passwordResets PasswordReset[]

  waiterConnection WaiterConnection?
  chefConnection   ChefConnection?

  ordersTaken  Order[] @relation("OrdersTaken")
  ordersPicked Order[] @relation("OrdersPicked")

  articles Article[]
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      Role
  token     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model WaiterConnection {
  id           Int      @id @default(autoincrement())
  orderTakerId Int      @unique
  socketId     String?  @unique
  sessionToken String   @unique
  isActive     Boolean  @default(true)
  fromTime     String?
  toTime       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  waiter Users @relation(fields: [orderTakerId], references: [id], onDelete: Cascade)
}

model ChefConnection {
  id           Int      @id @default(autoincrement())
  chefId       Int      @unique
  socketId     String?  @unique
  sessionToken String   @unique
  isActive     Boolean  @default(true)
  fromTime     String?
  toTime       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chef Users @relation(fields: [chefId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String   @db.Char(100)
  sku         String   @unique
  price       Float
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  menuItemId  Int
  name        String
  description String?
  quantity    Int     @default(1)
  price       Float
  total       Float

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model Order {
  id           Int         @id @default(autoincrement())
  orderTakerId Int?
  chefId       Int?
  status       OrderStatus @default(PENDING)
  totalAmount  Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orderTaker Users?      @relation("OrdersTaken", fields: [orderTakerId], references: [id])
  chef       Users?      @relation("OrdersPicked", fields: [chefId], references: [id])
  items      OrderItem[]
}

model Article {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(200)
  description       String   @db.Text
  image             String?
  restaurantName    String   @db.VarChar(150)
  restaurantWebsite String?  @db.VarChar(255)

  metaTitle         String?  @db.VarChar(70) 
  metaDescription   String?  @db.VarChar(160)   
  keywords          String?  @db.Text           
  address           String?  @db.VarChar(255)
  mapLink           String?  @db.VarChar(500)   
  phoneNumber       String?  @db.VarChar(50)
  openingHours      String?  @db.VarChar(255)  
  socialLinks       Json?

  isPublished       Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  publisherId       Int
  publisher         Users    @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publisherId])
  @@index([restaurantName])
  @@index([keywords])
}
