generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ────────────────────────────────────────────────
//  ENUMS
// ────────────────────────────────────────────────
//

enum OtpType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Role {
  Admin
  Order_Taker
  Shop_Owner
}

//
// ────────────────────────────────────────────────
//  MODELS
// ────────────────────────────────────────────────
//

/**
 * Users table - one record per email
 * A user can have multiple role accounts via UserRole junction table
 */
model Users {
  id              Int      @id @default(autoincrement())
  name            String   @db.Char(100)
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userRoles      UserRole[]
  otps           Otp[]
  passwordResets PasswordReset[]
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      Role
  token     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user Users @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user Users @relation(fields: [userId], references: [id])
}
